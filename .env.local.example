# Auth.js v5 configuration
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/quizswift?schema=public"

# App URL
AUTH_URL="http://localhost:3000"

# Vercel Blob Storage
BLOB_READ_WRITE_TOKEN=

# Inngest Background Jobs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# AI Providers
# OpenAI API Key (for embeddings and paid tier extraction)
OPENAI_API_KEY=

# Ollama (optional - for free tier, local AI)
# Install from https://ollama.ai/download then run: ollama pull llama3.1
# OLLAMA_HOST=http://localhost:11434
