# Auth.js v5 configuration
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_GOOGLE_ID="your-google-client-id.apps.googleusercontent.com"
AUTH_GOOGLE_SECRET="your-google-client-secret"

# Database (Neon PostgreSQL recommended)
DATABASE_URL="postgresql://user:password@localhost:5432/quizswift?schema=public"
DIRECT_URL="postgresql://user:password@localhost:5432/quizswift?schema=public"

# App URL
AUTH_URL="http://localhost:3000"

# Cloudflare R2 Storage (FERPA-compliant private storage)
CLOUDFLARE_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Inngest Background Jobs
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# AI Providers
# Ollama (required - free, local, FERPA-compliant)
# Install from https://ollama.com/download
# Pull models: ollama pull hermes2pro-32k && ollama pull mxbai-embed-large
OLLAMA_HOST=http://localhost:11434

# OpenAI API Key (optional - for paid tier)
OPENAI_API_KEY=
