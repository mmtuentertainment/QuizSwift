// QuizSwift Prisma Schema
// Auth.js v5 compatible models + FERPA audit logging + Content extraction

generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  extensions = [vector]
}

// Auth.js required models
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("teacher")

  accounts      Account[]
  sessions      Session[]
  documents     Document[]

  // Soft delete support for COPPA/GDPR compliance
  deletedAt     DateTime?

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
}

// Audit logging for FERPA compliance
model AuditLog {
  id         String   @id @default(cuid())
  tableName  String   @map("table_name")
  recordId   String   @map("record_id")
  action     String   // INSERT, UPDATE, DELETE, ANONYMIZE
  actorId    String?  @map("actor_id")
  actorType  String?  @map("actor_type") // teacher, admin, system
  oldData    Json?    @map("old_data")
  newData    Json?    @map("new_data")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([actorId])
  @@index([tableName])
  @@map("audit_log")
}

// Content extraction models for Phase 2

// Document: Uploaded PDF files with processing status
model Document {
  id           String   @id @default(cuid())
  fileName     String
  fileUrl      String   // Vercel Blob URL
  fileSize     Int      // bytes
  mimeType     String   @default("application/pdf")
  totalPages   Int?
  status       String   @default("pending") // pending, processing, extracting, completed, failed
  errorMessage String?
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  chunks       SourceChunk[]
  questions    ExtractedQuestion[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([uploadedById])
  @@index([status])
}

// SourceChunk: Text chunks for RAG/grounding
model SourceChunk {
  id         String   @id @default(cuid())
  documentId String
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  pageNumber Int
  chunkIndex Int      // Order within page
  startChar  Int
  endChar    Int
  embedding  Unsupported("vector(1536)")?
  createdAt  DateTime @default(now())

  @@index([documentId])
  @@index([pageNumber])
}

// ExtractedQuestion: Questions extracted from source material
model ExtractedQuestion {
  id                String   @id @default(cuid())
  documentId        String
  document          Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  questionText      String   @db.Text
  questionType      String   // multiple_choice, true_false, fill_blank, short_answer, matching, show_work, essay
  options           Json?    // Array of options for MC/matching
  correctAnswer     String   @db.Text
  explanation       String?  @db.Text
  sourceQuote       String   @db.Text  // Exact text from source
  pageNumber        Int
  sectionTitle      String?
  verified          Boolean  @default(false)
  verificationScore Float?   // Grounding similarity score (0-1)
  sourceChunkId     String?
  flagged           Boolean  @default(false) // True if below threshold
  flagReason        String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([documentId])
  @@index([verified])
  @@index([questionType])
}
